{"id": "b4fedf3c3a0dd971:tutorial:gpt-6-luna::subtopic:c6c9d2d7deb16b9d", "source_id": "b4fedf3c3a0dd971", "source_url": "https://www.investor.gov/introduction-investing", "topic": "Introduction of Investing", "subtopic": "Exchange-Traded Funds", "content_type": "tutorial", "teacher_model": "gpt-6-luna", "generation_status": "generated", "skip_reason": null, "grounding": "directly_supported", "source_evidence": "Many people choose to invest their contributions in a mutual fund or exchange-traded fund (ETF).", "question": null, "answer": "An exchange-traded fund (ETF) is one type of fund people may choose for investing contributions in a retirement account. The source identifies ETFs as an investment option but does not explain how they are structured or traded.", "formula_latex": null, "source_evidence_exact_match": true, "review_status": "unverified", "api_usage": {"input_tokens": 2887, "output_tokens": 339}}
