{"id": "aa0588951e64d843:qa:gpt-6-luna:", "source_id": "aa0588951e64d843", "source_url": "https://www.investor.gov/introduction-investing/investing-basics/save-and-invest/figure-out-your-finances", "topic": "Figure Out Your Finances", "subtopic": null, "content_type": "qa", "teacher_model": "gpt-6-luna", "generation_status": "generated", "skip_reason": null, "grounding": "directly_supported", "source_evidence": "Subtract your liabilities from your assets.", "question": "How do you calculate your net worth, and what does a positive net worth mean?", "answer": "Subtract what you owe (your liabilities) from what you own (your assets). Your net worth is positive when your assets are greater than your liabilities.", "formula_latex": "\\text{Net worth} = \\text{Assets} - \\text{Liabilities}", "source_evidence_exact_match": true, "review_status": "unverified", "api_usage": {"input_tokens": 1004, "output_tokens": 171}}
{"id": "aa0588951e64d843:misconception:gpt-6-luna:", "source_id": "aa0588951e64d843", "source_url": "https://www.investor.gov/introduction-investing/investing-basics/save-and-invest/figure-out-your-finances", "topic": "Figure Out Your Finances", "subtopic": null, "content_type": "misconception", "teacher_model": "gpt-6-luna", "generation_status": "generated", "skip_reason": null, "grounding": "derived_from_source", "source_evidence": "Subtract your liabilities from your assets.", "question": "Misconception: Your net worth is simply the total value of everything you own, so you don’t need to account for debts.", "answer": "Correction: Net worth accounts for both what you own and what you owe. Subtract your liabilities (debts) from your assets to calculate it.", "formula_latex": "\\text{Net worth} = \\text{Assets} - \\text{Liabilities}", "source_evidence_exact_match": true, "review_status": "unverified", "api_usage": {"input_tokens": 1004, "output_tokens": 278}}
